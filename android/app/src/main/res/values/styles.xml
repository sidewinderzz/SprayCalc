<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- White rather than @null: the app's own surface is white at the top,
             so this keeps the area behind the status bar matching instead of
             showing through to black. On Android 15+, where statusBarColor is
             ignored and the window is edge-to-edge, this is what shows. -->
        <item name="android:background">@color/appBackground</item>
        <item name="android:statusBarColor">@color/appBackground</item>
        <!-- Dark status bar icons, since that bar is white. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/appBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>