# Google Analytics (optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public URL of the deployed PWA. Only matters for the Android build, where
# the app is served from https://localhost and so cannot use relative URLs for
# the OCR function, share links, or the QR code on exported PDFs.
# Defaults to https://spraycalc.netlify.app — set this if the site moves.
# VITE_PUBLIC_APP_URL=https://spraycalc.netlify.app

# Firebase — Google Sign-In + cloud mix sync (optional).
# All four required vars must be set at build time or the sign-in UI is hidden
# and the app falls back to localStorage-only saves.
# Values come from Firebase Console → Project settings → Your apps → Web app.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=

# Optional Firebase extras (not required for auth/Firestore sync)
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
